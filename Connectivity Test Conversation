          <p className="mt-4 text-sm text-muted font-mono">Laster…</p>
        </div>
      </div>
    );
  }

  if (!isAuthenticated) return null;

  if (requiredRole === "admin" && !isAdmin) return null;
  if (requiredRole === "organizer" && !isOrganizer) return null;

  return <>{children}</>;
}

